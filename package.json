{
  "name": "campus-tree-visualization",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,ui \"uv run tree\" \"vite --config frontend/vite.config.ts\"",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}